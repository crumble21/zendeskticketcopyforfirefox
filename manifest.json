{
  "manifest_version": 2,
  "name": "Zendesk Ticket Copy + Open in Obsidian",
  "version": "1.5.0",
  "description": "Adds copy and Open in Obsidian buttons next to the ticket number in Zendesk.",
  "author": "Hayden Beckett <hayden@haydenbeckett.co.uk>",
  "icons": {
    "48": "logox48.png",
    "96": "logox96.png"
  },
  "permissions": [
    "storage",
    "*://*.zendesk.com/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "browser_action": {
    "default_icon": "logox48.png",
    "default_title": "Ticket Button Settings",
    "default_popup": "options.html"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.zendesk.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    "chime.mp3"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "zendesk-open-in-obsidian@crumblecloud.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}